{
  "name": "cyberpunk-tcg-online",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/web.mjs dev",
    "build": "npm run codegen && node scripts/web.mjs build",
    "start": "node scripts/web.mjs start",
    "lint": "eslint .",
    "typecheck": "npm run codegen && tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "validate:cards": "node --import tsx scripts/validate-card-data.ts",
    "mongo:indexes": "node --import tsx scripts/create-mongo-indexes.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "db:migrate": "node --import tsx scripts/migrate-postgres.ts",
    "mongo:seed": "node --import tsx scripts/seed-mongo.ts",
    "training:demo": "node --import tsx scripts/training-demo.ts",
    "engine:worker": "node --import tsx scripts/engine-worker.ts",
    "contracts:export": "node --import tsx scripts/export-wire-schemas.ts",
    "test:matrix": "node --import tsx scripts/generate-demo-match-matrix.ts",
    "review:descriptor-v2": "node --import tsx scripts/review-public-actions-v2.ts"
  },
  "dependencies": {
    "@next/env": "16.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/typescript": "^5.0.0",
    "@graphql-codegen/typescript-resolvers": "^5.0.0",
    "@graphql-codegen/typescript-operations": "^5.0.0",
    "@graphql-codegen/typed-document-node": "^6.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23"
  }
}

# Fixture-only mode (default): leave MONGODB_URI empty. No databases required for cards/deck validation.
# An empty value in .env.local overrides an existing value in .env.
MONGODB_URI=

# Mongo-backed mode: replace the empty value above with this URI, then restart Next.js.
# Start services: npm run infra:up
# Create indexes: npm run mongo:indexes
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cyberpunk_tcg_content

# PostgreSQL platform data; matches docker-compose.yml development credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cyberpunk_tcg

# Apollo server-side requests; browser requests use /api/graphql.
GRAPHQL_INTERNAL_URL=http://localhost:3000/api/graphql

# Optional Compose host ports if defaults are occupied (also update the URIs above).
# POSTGRES_PORT=5433
# MONGO_PORT=27018
